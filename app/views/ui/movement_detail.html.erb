<div class="pagehead"><h1><%= @title %> <%= pill(m["status"]) %></h1></div>
<div class="card"><dl class="facts">
  <dt>Product</dt><dd><%= product.sku %> <%= product.name %></dd>
  <dt>Warehouse</dt><dd><%= warehouse.code %> <%= warehouse.name %></dd>
  <dt>Type</dt><dd><%= label(m["movement_type"]) %></dd>
  <dt>Date</dt><dd><%= m["movement_date"] %></dd>
  <dt>Quantity</dt><dd><%= qty(m["quantity"]) %></dd>
  <dt>Unit cost</dt><dd><%= amount(m["unit_cost"]) %></dd>
  <dt>Total cost</dt><dd><%= amount(m["total_cost"]) %></dd>
  <dt>Reference</dt><dd><%= dash(m["reference"]) %></dd>
  <dt>Notes</dt><dd><%= m["notes"].present? ? simple_format(m["notes"], {}, wrapper_tag: "span") : "—" %></dd>
  <dt>Source</dt><dd><%= m["source_type"] ? "Order fulfilment (#{label(m["source_type"])})" : "Entered by hand" %></dd>
  <dt>Journal entry</dt><dd><% if m["journal_entry_id"] %><a href="/journal-entries/<%= m["journal_entry_id"] %>">Entry <%= m["journal_entry_id"] %></a><% else %>—<% end %></dd>
</dl></div>
<h2>Actions</h2>
<div class="card">
  <div class="actions">
  <% if m["status"] == "draft" %>
    <% if %w[receipt issue].include?(m["movement_type"]) %>
    <form method="post" action="/stock-movements/<%= m["id"] %>/post" class="actions"><%= form_token_field %>
      <% if m["movement_type"] == "receipt" %>
      <label>Account to credit
        <select class="auto" name="credit_account_id"><%= options(credit_choices, default_credit) %></select>
      </label>
      <% end %>
      <button class="primary">Post</button>
    </form>
    <% else %><span class="muted">Only receipts and issues post to the ledger.</span><% end %>
    <% unless m["source_type"] %><a class="button" href="/stock-movements/<%= m["id"] %>/edit">Edit</a><% end %>
    <a class="button" href="/stock-movements/<%= m["id"] %>/delete">Delete</a>
  <% elsif current_user.is_admin %>
    <%= action_button "Unpost", "/stock-movements/#{m["id"]}/unpost" %>
  <% end %>
  </div>
  <%= render "ui/action_errors", errors: %>
</div>
