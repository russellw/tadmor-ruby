<div class="pagehead"><h1>Cash flow</h1></div>
<%= render "ui/report_filters", filters:, error: %>
<div class="tablewrap"><table class="grid">
  <thead><tr><th>Code</th><th>Account</th><th class="num">Amount</th></tr></thead>
  <tbody>
  <% sections.each do |s| %>
    <tr class="section"><td colspan="3"><%= s[:name].capitalize %> activities</td></tr>
    <% if s[:name] == "operating" %><tr><td></td><td>Net income</td><td class="num"><%= money_span(cf["net_income"]) %></td></tr><% end %>
    <% s[:rows].each do |r| %><tr><td><a href="/accounts/<%= r["account_id"] %>/ledger"><%= r["code"] %></a></td><td><%= r["name"] %></td><td class="num"><%= money_span(r["amount"]) %></td></tr><% end %>
    <tr class="subtotal"><td colspan="2">Net cash from <%= s[:name] %> activities</td><td class="num"><%= money_span(s[:subtotal]) %></td></tr>
  <% end %>
  </tbody>
  <tfoot>
    <tr><td colspan="2">Opening cash</td><td class="num"><%= amount(cf["opening_cash"]) %></td></tr>
    <tr><td colspan="2">Net cash flow</td><td class="num"><%= money_span(cf["net_cash_flow"]) %></td></tr>
    <tr><td colspan="2">Closing cash</td><td class="num"><%= amount(cf["closing_cash"]) %></td></tr>
  </tfoot>
</table></div>
